# Docker Compose installation profile
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chat

NODE_ENV=production
PUBLIC_HOST=chat.example.com
PUBLIC_URL=https://chat.example.com
ALLOWED_ORIGINS=https://chat.example.com

CLIENT_HTTP_BIND=0.0.0.0
CLIENT_HTTP_PORT=80
CLIENT_HTTPS_BIND=0.0.0.0
CLIENT_HTTPS_PORT=443

SERVER_BIND=127.0.0.1
SERVER_PORT=3000

POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Database Connection Pool Settings
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5

RESTART_POLICY=unless-stopped

# Pub/Sub adapter: "postgres" (default, no extra infra) or "redis" (horizontal scaling)
PUBSUB_ADAPTER=postgres
# Required only when PUBSUB_ADAPTER=redis
REDIS_URL=redis://localhost:6379
